# DAF Benchmark Example Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Ollama Cloud Configuration
# =============================================================================
# Ollama Cloud provides access to open-source models via their API
# Available models: qwen3.5, glm-5.2, minimax-m3, kimi-k2.6, etc.

OLLAMA_API_BASE=https://ollama.com
OLLAMA_API_KEY=your-ollama-api-key

# =============================================================================
# OpenRouter Configuration
# =============================================================================
# OpenRouter provides access to 200+ models from various providers
# Models: Claude Sonnet/Opus, Sol, Terra, GPT-4, Gemini, etc.

OPENROUTER_API_KEY=sk-or-your-openrouter-key

# =============================================================================
# OpenAI Configuration (for comparison)
# =============================================================================
# Set this if you want to compare with OpenAI models

# OPENAI_API_KEY=sk-your-openai-key

# =============================================================================
# Anthropic Configuration (for comparison)
# =============================================================================

# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# =============================================================================
# DAF Backend Configuration
# =============================================================================
# If you have a DAF backend running, set these to use the DAF adapter

DAF_BASE_URL=http://localhost:8012
DAF_API_KEY=daf_your_api_key

# =============================================================================
# Google Gemini Configuration (for comparison)
# =============================================================================

# GOOGLE_API_KEY=your-google-api-key

